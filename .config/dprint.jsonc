{
  "excludes": [
    "../.git/**",
    "../.github/release-please-manifest.json",
    "../.mypy_cache/**",
    "../.venv/**",
    "../custom_components/jatekukko/manifest.json",
    "../custom_components/*/translations/*.json",
  ],
  "plugins": [
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/toml@0.10.0",
    "npm:dprint-plugin-yaml@0.6.0",
  ],
}
